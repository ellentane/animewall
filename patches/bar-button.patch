A button for the animewall panel just left of the tray: click opens the
panel, right click switches to the next wallpaper and middle click
favorites it. bar.utilButtons.showAnimewall hides it.
Made against end-4/dots-hyprland 6eb590b1, dots/.config/quickshell/ii.

--- a/modules/common/Config.qml
+++ b/modules/common/Config.qml
@@ -257,6 +257,7 @@
                     property bool showDarkModeToggle: true
                     property bool showPerformanceProfileToggle: false
                     property bool showScreenRecord: false
+                    property bool showAnimewall: true
                 }
                 property JsonObject workspaces: JsonObject {
                     property bool monochromeIcons: true
--- a/modules/ii/bar/BarContent.qml
+++ b/modules/ii/bar/BarContent.qml
@@ -324,6 +324,38 @@
                 invertSide: Config?.options.bar.bottom
             }
 
+            Loader { // Anime wallpaper panel (left click), next wallpaper (right click), favorite (middle click)
+                active: Config.options.bar.utilButtons.showAnimewall
+                visible: active
+                Layout.fillWidth: false
+                Layout.alignment: Qt.AlignVCenter
+                sourceComponent: RippleButton {
+                    id: animewallButton
+                    implicitWidth: 30
+                    implicitHeight: 30
+                    buttonRadius: Appearance.rounding.full
+                    toggled: GlobalStates.animewallOpen
+                    colBackgroundToggled: Appearance.colors.colSecondaryContainer
+                    colBackgroundToggledHover: Appearance.colors.colSecondaryContainerHover
+                    colRippleToggled: Appearance.colors.colSecondaryContainerActive
+                    onClicked: GlobalStates.animewallOpen = !GlobalStates.animewallOpen
+                    altAction: () => Animewall.skip()
+                    middleClickAction: () => Animewall.toggleFavorite()
+                    contentItem: Item {
+                        MaterialSymbol {
+                            anchors.centerIn: parent
+                            text: "photo_library"
+                            fill: animewallButton.toggled ? 1 : 0
+                            iconSize: Appearance.font.pixelSize.larger
+                            color: animewallButton.toggled ? Appearance.colors.colOnSecondaryContainer : Appearance.colors.colOnLayer0
+                        }
+                    }
+                    StyledToolTip {
+                        text: "Wallpapers · click: panel · right-click: next · middle-click: favorite"
+                    }
+                }
+            }
+
             Item {
                 Layout.fillWidth: true
                 Layout.fillHeight: true
