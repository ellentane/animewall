#!/usr/bin/env python3
"""animewall: Wallhaven wallpaper libraries with rotation and controls.

  animewall next                          switch to a random wallpaper from the current selection
  animewall source anime|real|mixed|favorites
                                          choose which library rotates
  animewall purity sfw|sketchy|nsfw ...   choose which purities rotate ("all" for every one)
  animewall favorite                      add or remove the current wallpaper from favorites
  animewall filter hide|unhide TAG ...    hide wallpapers with any of these tags, or show them again
  animewall filter [clear]                list the hidden tags, or hide nothing
  animewall ban                           take the current wallpaper out for good (moved, not deleted)
  animewall open                          open the current wallpaper's Wallhaven page
  animewall interval 5|10|15|30|60        minutes between automatic changes
  animewall pause | resume                stop or restart the rotation timer
  animewall download start|stop|run       background download service, or download in the foreground
  animewall status [--json]               state, used by the quickshell panel
  animewall fetch                         grow the libraries in the foreground

Config: ~/.config/animewall/config.toml (created on first run).
"""
import json
import os
import random
import re
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/animewall/config.toml"
STATE = HOME / ".local/state/animewall"
FILTER = STATE / "filter.json"
QUEUE = STATE / "queue.json"
TAGS = STATE / "tags.json"
REJECTED = STATE / "rejected.json"
BANNED = STATE / "banned"
UNIT_DIR = HOME / ".config/systemd/user"
TIMER_UNIT = UNIT_DIR / "animewall.timer"
TIMER_DROPIN = UNIT_DIR / "animewall.timer.d/interval.conf"
CURRENT = HOME / ".config/illogical-impulse/config.json"
SWITCHWALL = HOME / ".config/quickshell/ii/scripts/colors/switchwall.sh"
API = "https://wallhaven.cc/api/v1"
UA = "animewall/1.0"
PURITIES = ("sfw", "sketchy", "nsfw")
PURITY_BITS = {"sfw": "100", "sketchy": "010", "nsfw": "001"}
SOURCES = ("anime", "real", "mixed", "favorites")
INTERVALS = (5, 10, 15, 30, 60)
DEFAULT_FILTER = {"source": "anime", "purities": ["sketchy"], "hide": []}
WALLHAVEN_FILE = re.compile(r"wallhaven-([a-z0-9]+)\.\w+$", re.I)

DEFAULT_CONFIG = """\
# Wallhaven API key, needed for NSFW results: https://wallhaven.cc/settings/account
# (also enable NSFW in your Wallhaven browsing settings). Or set WALLHAVEN_API_KEY.
api_key = ""

# Downloads always follow the panel's selection (source and purities).
library = "~/Pictures/Wallpapers/anime"
min_resolution = "2560x1440"
ratios = "16x10,16x9"
# Caps: each purity folder stops at max_images, and the whole library at max_gb.
max_images = 1500
max_gb = 20
# Wallhaven sort orders walked in turn.
sortings = ["favorites", "toplist", "views"]

# Non-anime library (Wallhaven "general" + "people" categories).
other_library = "~/Pictures/Wallpapers/other"
other_categories = "101"
other_max_images = 400   # per purity, like max_images
other_max_gb = 6
# Search terms for the non-anime library, each searched in turn per sort order with
# other_exclude added ("-tag" leaves a tag out). No terms searches the whole categories.
other_queries = []
other_exclude = ""

# Share of "mixed" rotations that come from the non-anime library (the rest from anime).
mixed_real_share = 20
# Favorites are copies kept apart from the downloaded libraries.
favorites_library = "~/Pictures/Wallpapers/favorites"
"""


def load_config():
    if not CONFIG.exists():
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(DEFAULT_CONFIG)
    cfg = tomllib.loads(DEFAULT_CONFIG) | tomllib.loads(CONFIG.read_text())
    cfg["api_key"] = os.environ.get("WALLHAVEN_API_KEY") or cfg["api_key"]
    for key in ("library", "other_library", "favorites_library"):
        cfg[key] = Path(cfg[key]).expanduser()
    return cfg


def libraries(cfg):
    return {"anime": cfg["library"], "real": cfg["other_library"], "favorites": cfg["favorites_library"]}


def other_searches(cfg):
    """The non-anime library's searches: each of other_queries with other_exclude added."""
    exclude = cfg["other_exclude"]
    return [f"{q} {exclude}".strip() for q in cfg["other_queries"]] or [exclude]


def source_specs(cfg):
    """(name, dir, wallhaven categories, max images, max GB, search queries) for the downloads."""
    return [
        ("anime", cfg["library"], "010", cfg["max_images"], cfg["max_gb"], [""]),
        ("real", cfg["other_library"], cfg["other_categories"], cfg["other_max_images"],
         cfg["other_max_gb"], other_searches(cfg)),
    ]


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def notify(msg, urgent=False):
    cmd = ["notify-send", "-a", "animewall", *(["-u", "critical"] if urgent else []), msg]
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(msg)


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def unit_state(unit):
    return systemctl("is-active", unit).stdout.strip()


class Api:
    """Wallhaven allows 45 API calls a minute."""

    def __init__(self, key):
        self.key, self.last = key, 0.0

    def get(self, path, **params):
        if self.key:
            params["apikey"] = self.key
        url = f"{API}{path}?{urllib.parse.urlencode(params)}"
        for attempt in range(5):
            time.sleep(max(0, 1.4 - (time.time() - self.last)))
            self.last = time.time()
            try:
                req = urllib.request.Request(url, headers={"User-Agent": UA})
                with urllib.request.urlopen(req, timeout=30) as r:
                    return json.load(r)
            except urllib.error.HTTPError as e:
                if e.code == 429:
                    log("rate limited, waiting 60s")
                    time.sleep(60)
                    continue
                raise
            except (urllib.error.URLError, TimeoutError) as e:
                log(f"network error ({e}), retrying")
                time.sleep(10 * (attempt + 1))
        raise RuntimeError(f"giving up on {path}")


def library_files(lib, purities=PURITIES):
    return [p for d in purities if (lib / d).is_dir()
            for p in (lib / d).iterdir() if p.suffix.lower() in (".jpg", ".jpeg", ".png")]


# ---- downloads -------------------------------------------------------------

def load_rejected():
    return set(json.loads(REJECTED.read_text())) if REJECTED.exists() else set()


def add_rejected(wid):
    STATE.mkdir(parents=True, exist_ok=True)
    REJECTED.write_text(json.dumps(sorted(load_rejected() | {wid})))


FETCH_UNIT = "animewall-fetch.service"


def downloading():
    return unit_state(FETCH_UNIT) in ("active", "activating")


def start_download():
    """Start the download service, or restart it so it follows a changed selection."""
    systemctl("restart" if downloading() else "start", "--no-block", FETCH_UNIT)


def download_targets(cfg, filt):
    names = {"anime": ["anime"], "real": ["real"], "mixed": ["anime", "real"], "favorites": []}[filt["source"]]
    return [spec for spec in source_specs(cfg) if spec[0] in names]


def fetch(cfg):
    """Download for the current selection: its libraries and purities, each purity up to its cap."""
    filt = load_filter()
    purities = list(filt["purities"])
    if "nsfw" in purities and not cfg["api_key"]:
        log("no API key set, skipping NSFW (see", CONFIG, ")")
        purities.remove("nsfw")
    targets = download_targets(cfg, filt)
    if not targets or not purities:
        log(f"nothing to download for {filt['source']} ({', '.join(filt['purities'])})")
        return
    # An empty selection shows its first download right away instead of waiting for the timer.
    state = {"waiting": not pools(cfg, filt), "hide": hide_pattern(filt)}
    for name, lib, cats, max_images, max_gb, queries in targets:
        for purity in purities:
            log(f"== {name} / {purity} ==")
            fetch_source(cfg, lib, cats, max_images, max_gb, queries, purity, state)


def fetch_source(cfg, lib, categories, max_images, max_gb, queries, purity, state):
    folder = lib / purity
    folder.mkdir(parents=True, exist_ok=True)
    for part in folder.glob("*.part"):  # leftovers from an interrupted download
        part.unlink(missing_ok=True)
    rejected = load_rejected()
    have = {p.stem.removeprefix("wallhaven-") for p in library_files(lib)}
    count = len(library_files(lib, (purity,)))
    size = sum(p.stat().st_size for p in library_files(lib))
    max_bytes = max_gb * 1024**3
    api = Api(cfg["api_key"])
    log(f"{count}/{max_images} {purity} images, library {size / 1024**3:.1f}/{max_gb} GB")

    def full():
        return count >= max_images or size >= max_bytes

    for sorting in cfg["sortings"]:
        for query in queries:
            page, last = 1, 1
            while page <= last and not full():
                res = api.get("/search", q=query, categories=categories, purity=PURITY_BITS[purity],
                              atleast=cfg["min_resolution"], ratios=cfg["ratios"],
                              sorting=sorting, order="desc", page=page)
                last = res["meta"]["last_page"]
                for w in res["data"]:
                    if full():
                        break
                    wid = w["id"]
                    if wid in have or wid in rejected or w["purity"] != purity:
                        continue
                    try:
                        info = api.get(f"/w/{wid}")["data"]
                    except Exception as e:
                        log(f"skip {wid}: detail lookup failed ({e})")
                        continue
                    if info["purity"] != purity:
                        continue
                    names = tag_names(info)
                    if is_hidden(state["hide"], names):
                        log(f"skip {wid}: has a hidden tag")
                        continue
                    dest = folder / Path(urllib.parse.urlparse(info["path"]).path).name
                    tmp = dest.with_suffix(dest.suffix + ".part")
                    try:
                        req = urllib.request.Request(info["path"], headers={"User-Agent": UA})
                        with urllib.request.urlopen(req, timeout=120) as r, open(tmp, "wb") as f:
                            while chunk := r.read(1 << 20):
                                f.write(chunk)
                        if tmp.stat().st_size != info["file_size"]:
                            raise IOError("size mismatch")
                        tmp.rename(dest)
                    except Exception as e:
                        tmp.unlink(missing_ok=True)
                        log(f"download failed {wid}: {e}")
                        continue
                    record_tags({wid: names})
                    have.add(wid)
                    count += 1
                    size += info["file_size"]
                    log(f"[{count}/{max_images}] {purity:7} {info['resolution']:>9} {dest.name}")
                    if state["waiting"]:
                        state["waiting"] = False
                        cmd_next(cfg)
                page += 1
    log(f"done: {count} {purity} images, {size / 1024**3:.1f} GB in {lib}")


# ---- selection -------------------------------------------------------------

def load_filter():
    try:
        f = json.loads(FILTER.read_text())
        purities = [p for p in PURITIES if p in f.get("purities", [])]
        hide = sorted({str(t).strip().lower() for t in f.get("hide", []) if str(t).strip()})
        if f.get("source") in SOURCES and purities:
            return {"source": f["source"], "purities": purities, "hide": hide}
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return dict(DEFAULT_FILTER, purities=list(DEFAULT_FILTER["purities"]), hide=[])


def save_filter(f):
    STATE.mkdir(parents=True, exist_ok=True)
    FILTER.write_text(json.dumps(f))


def load_tags():
    """{wallhaven id: tag names} for the wallpapers whose tags are known."""
    try:
        return json.loads(TAGS.read_text())
    except (OSError, ValueError):
        return {}


def record_tags(entries):
    # Merged into what is on disk right before writing: the download and the tag
    # lookup can both be writing at once.
    index = load_tags() | entries
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = TAGS.with_suffix(".tmp")
    tmp.write_text(json.dumps(index, sort_keys=True))
    tmp.replace(TAGS)


def tag_names(info):
    return [t["name"].lower() for t in info.get("tags", []) if t.get("name")]


def hide_pattern(filt):
    """The hidden tags as whole words on a tag name, plurals included, or None."""
    if not filt["hide"]:
        return None
    return re.compile(r"\b(" + "|".join(re.escape(t) for t in filt["hide"]) + r")s?\b")


def is_hidden(pattern, names):
    return bool(pattern) and any(pattern.search(n.replace("_", " ")) for n in names)


def pools(cfg, filt):
    """[(library name, files, weight)] for the chosen source, with the mixed split applied."""
    if filt["source"] == "mixed":
        real = cfg["mixed_real_share"]
        spec = [("anime", 100 - real), ("real", real)]
    else:
        spec = [(filt["source"], 100)]
    libs = libraries(cfg)
    pattern = hide_pattern(filt)
    index = load_tags() if pattern else {}
    out = []
    for name, weight in spec:
        if weight <= 0:
            continue
        files = [p for p in library_files(libs[name], filt["purities"])
                 if not is_hidden(pattern, index.get(wallhaven_id(str(p)), []))]
        if files:
            out.append((name, files, weight))
    return out


def choose(cfg, filt, exclude=None):
    """Next wallpaper: each library works through a shuffled bag, so nothing repeats until all have shown."""
    key = json.dumps([filt["source"], filt["purities"]])
    options = []
    for name, files, weight in pools(cfg, filt):
        valid = {str(p) for p in files} - {exclude}
        if valid:
            options.append((name, valid, weight))
    if not options:
        return None
    saved = json.loads(QUEUE.read_text()) if QUEUE.exists() else {}
    bags = saved.get("bags", {}) if saved.get("key") == key else {}
    name, valid, _ = random.choices(options, weights=[o[2] for o in options])[0]
    bag = [b for b in bags.get(name, []) if b in valid]
    if not bag:
        bag = sorted(valid)
        random.shuffle(bag)
    pick = bag.pop()
    bags[name] = bag
    STATE.mkdir(parents=True, exist_ok=True)
    QUEUE.write_text(json.dumps({"key": key, "bags": bags}))
    return pick


def show(path):
    # No prompts from an automatic change: switchwall's "Upscale?" question waits for a
    # click that never comes, and each rotation left one stuck behind (51 by 25 Nov).
    env = {**hypr_env(), "SWITCHWALL_NO_PROMPTS": "1"}
    subprocess.run([str(SWITCHWALL), "--image", path], env=env, check=True,
                   stdout=subprocess.DEVNULL)


def hypr_env():
    env = dict(os.environ)
    run = Path(env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig or not (run / "hypr" / sig).exists():
        dirs = sorted((run / "hypr").glob("*"), key=lambda p: p.stat().st_mtime)
        if dirs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = dirs[-1].name
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(run.glob("wayland-[0-9]"))
        if socks:
            env["WAYLAND_DISPLAY"] = socks[0].name
    return env


# ---- current wallpaper -----------------------------------------------------

def current_path():
    try:
        p = json.loads(CURRENT.read_text())["background"]["wallpaperPath"]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return str(Path(p)) if p else None


def locate(cfg, path):
    """(library name, purity) for a file inside one of our libraries, else None."""
    if not path:
        return None
    for name, lib in libraries(cfg).items():
        try:
            rel = Path(path).relative_to(lib)
        except ValueError:
            continue
        if len(rel.parts) == 2 and rel.parts[0] in PURITIES:
            return name, rel.parts[0]
    return None


def wallhaven_id(path):
    m = WALLHAVEN_FILE.search(Path(path).name) if path else None
    return m.group(1).lower() if m else None


def favorite_copies(cfg, wid):
    fav = cfg["favorites_library"]
    return [p for p in fav.glob(f"*/wallhaven-{wid}.*")] if fav.is_dir() else []


# ---- commands --------------------------------------------------------------

def selection_label(filt):
    return f"{filt['source']} {' + '.join(p.upper() for p in filt['purities'])}"


def cmd_next(cfg):
    filt = load_filter()
    pick = choose(cfg, filt)
    if pick is None:
        msg = f"No {selection_label(filt)} wallpapers yet."
        if downloading():
            print(msg, "Still downloading; keeping the current wallpaper.")
        elif os.environ.get("INVOCATION_ID"):  # run by the timer: no popup every few minutes
            print(msg)
        else:
            notify(msg + " Press Download more in the panel.")
        return 0 if downloading() or os.environ.get("INVOCATION_ID") else 1
    show(pick)
    print(pick)
    return 0


def apply_selection(cfg, filt):
    """Save the selection and switch to it. An empty selection starts downloading for it."""
    if filt["source"] == "favorites" and not pools(cfg, filt):
        notify(f"No favorites match {' + '.join(p.upper() for p in filt['purities'])} yet. "
               "Use Favorite on a wallpaper first.", urgent=True)
        return 1
    save_filter(filt)
    pick = choose(cfg, filt)
    if downloading() or pick is None:
        start_download()  # downloads always follow the selection
    if pick is None:
        notify(f"No {selection_label(filt)} wallpapers yet. Downloading some now; "
               "the wallpaper changes when the first one arrives.")
        return 0
    show(pick)
    return 0


def cmd_source(cfg, args):
    if len(args) != 1 or args[0] not in SOURCES:
        print(f"usage: animewall source {'|'.join(SOURCES)}")
        return 2
    filt = load_filter()
    filt["source"] = args[0]
    return apply_selection(cfg, filt)


def cmd_purity(cfg, args):
    if args == ["all"]:
        wanted = list(PURITIES)
    elif args and all(a in PURITIES for a in args):
        wanted = [p for p in PURITIES if p in args]
    else:
        print("usage: animewall purity sfw|sketchy|nsfw ... | all")
        return 2
    filt = load_filter()
    filt["purities"] = wanted
    return apply_selection(cfg, filt)


def cmd_filter(cfg, args):
    filt = load_filter()
    action = args[0] if args else ""
    tags = {t.strip().lower() for t in args[1:] if t.strip()}
    if action == "hide" and tags:
        filt["hide"] = sorted(set(filt["hide"]) | tags)
    elif action == "unhide" and tags:
        filt["hide"] = [t for t in filt["hide"] if t not in tags]
    elif action == "clear" and not tags:
        filt["hide"] = []
    elif action:
        print("usage: animewall filter [hide|unhide TAG ... | clear]")
        return 2
    if action:
        save_filter(filt)
        cur = current_path()
        if cur and is_hidden(hide_pattern(filt), load_tags().get(wallhaven_id(cur) or "", [])):
            pick = choose(cfg, filt, exclude=cur)
            if pick:
                show(pick)
    print("hidden tags:", ", ".join(filt["hide"]) or "none")
    return 0


def cmd_favorite(cfg):
    cur = current_path()
    loc = locate(cfg, cur)
    wid = wallhaven_id(cur)
    if not cur or not loc or not wid:
        notify("Only wallpapers from the animewall libraries can be favorited.", urgent=True)
        return 1
    copies = favorite_copies(cfg, wid)
    if copies:  # already a favorite: remove it
        if cur in {str(c) for c in copies}:
            pick = choose(cfg, load_filter(), exclude=cur)
            if pick is None:
                notify("Nothing else to switch to, so the favorite stays.", urgent=True)
                return 1
            show(pick)
        for c in copies:
            c.unlink(missing_ok=True)
        notify(f"Removed {wid} from favorites")
        return 0
    dest = cfg["favorites_library"] / loc[1] / Path(cur).name
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(cur, dest)
    notify(f"Saved {wid} to favorites")
    return 0


def cmd_ban(cfg):
    cur = current_path()
    loc = locate(cfg, cur)
    wid = wallhaven_id(cur)
    if not cur or not loc or not wid:
        notify("Only wallpapers from the animewall libraries can be banned.", urgent=True)
        return 1
    pick = choose(cfg, load_filter(), exclude=cur)
    if pick is None:
        notify("Nothing else to switch to, so the ban was cancelled.", urgent=True)
        return 1
    show(pick)
    add_rejected(wid)
    BANNED.mkdir(parents=True, exist_ok=True)
    moved = 0
    for lib in libraries(cfg).values():
        for f in lib.glob(f"*/wallhaven-{wid}.*"):
            shutil.move(str(f), BANNED / f.name)
            moved += 1
    notify(f"Banned {wid}: moved {moved} file(s) to {BANNED}")
    return 0


def cmd_open():
    wid = wallhaven_id(current_path())
    if not wid:
        notify("This wallpaper has no Wallhaven page.", urgent=True)
        return 1
    subprocess.Popen(["xdg-open", f"https://wallhaven.cc/w/{wid}"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def interval_minutes():
    for f in (TIMER_DROPIN, TIMER_UNIT):
        try:
            text = f.read_text()
        except OSError:
            continue
        if "OnCalendar=hourly" in text:
            return 60
        m = re.search(r"OnCalendar=\*:0/(\d+)", text)
        if m:
            return int(m.group(1))
    return 5


def cmd_interval(args):
    try:
        n = int(args[0])
    except (IndexError, ValueError):
        n = None
    if n not in INTERVALS:
        print(f"usage: animewall interval {'|'.join(map(str, INTERVALS))}")
        return 2
    TIMER_DROPIN.parent.mkdir(parents=True, exist_ok=True)
    spec = "hourly" if n == 60 else f"*:0/{n}"
    TIMER_DROPIN.write_text(f"[Timer]\nOnCalendar=\nOnCalendar={spec}\n")
    systemctl("daemon-reload")
    if unit_state("animewall.timer") == "active":
        systemctl("restart", "animewall.timer")
    print(f"changing every {n} minutes")
    return 0


def cmd_timer(action):
    r = systemctl(action, "animewall.timer")
    print("rotation " + ("paused" if action == "stop" else "resumed"))
    return r.returncode


def cmd_download(cfg, args):
    action = args[0] if args else ""
    if action == "start":
        if not download_targets(cfg, load_filter()):
            notify("Favorites can't be downloaded. Pick Anime, Real or Mixed first.", urgent=True)
            return 1
        start_download()
        print("download started for", selection_label(load_filter()))
    elif action == "stop":
        systemctl("stop", FETCH_UNIT)
        print("download stopped")
    elif action == "run":
        fetch(cfg)
    else:
        print("usage: animewall download start|stop|run")
        return 2
    return 0


def status_data(cfg):
    filt = load_filter()
    cur = current_path()
    loc = locate(cfg, cur)
    wid = wallhaven_id(cur)
    pool = sum(len(files) for _, files, _ in pools(cfg, filt))
    counts = {name: {p: len(library_files(lib, (p,))) for p in PURITIES}
              for name, lib in libraries(cfg).items()}
    return {
        "current": {
            "path": cur,
            "name": Path(cur).name,
            "wallhaven_id": wid,
            "library": loc[0] if loc else None,
            "purity": loc[1] if loc else None,
            "favorite": bool(wid and favorite_copies(cfg, wid)),
        } if cur else None,
        "source": filt["source"],
        "purities": filt["purities"],
        "pool": pool,
        "filter": {
            "hide": filt["hide"],
            "hidden": sum(len(files) for _, files, _ in pools(cfg, dict(filt, hide=[]))) - pool,
        },
        "timer": {
            "active": unit_state("animewall.timer") == "active",
            "interval_min": interval_minutes(),
            "next": systemctl("show", "animewall.timer", "-p", "NextElapseUSecRealtime", "--value")
                    .stdout.strip() or None,
        },
        "download": downloading(),
        "libraries": counts,
        "banned": len(list(BANNED.iterdir())) if BANNED.is_dir() else 0,
        "api_key": bool(cfg["api_key"]),
    }


def cmd_status(cfg, args):
    data = status_data(cfg)
    if "--json" in args:
        print(json.dumps(data, ensure_ascii=False))
        return 0
    cur = data["current"]
    print("current:", f"{cur['name']} ({cur['library'] or 'outside libraries'}, "
          f"{cur['purity'] or '-'}{', favorite' if cur['favorite'] else ''})" if cur else "none")
    print("source:", data["source"], "| purities:", ", ".join(data["purities"]), "| pool:", data["pool"])
    f = data["filter"]
    print("hidden tags:", ", ".join(f["hide"]) or "none", f"| {f['hidden']} wallpapers hidden")
    t = data["timer"]
    print("rotation:", "active" if t["active"] else "paused", f"| every {t['interval_min']} min",
          f"| next {t['next'] or '-'}")
    print("download:", "running" if data["download"] else "idle")
    for name, c in data["libraries"].items():
        print(f"{name:10}", ", ".join(f"{p} {n}" for p, n in c.items()))
    print("banned:", data["banned"], "| api key:", "set" if data["api_key"] else "missing")
    return 0


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("status", [])
    cfg = load_config()
    if cmd == "status":
        return cmd_status(cfg, args)
    if cmd == "next":
        return cmd_next(cfg)
    if cmd == "fetch":
        fetch(cfg)
        return 0
    if cmd == "source":
        return cmd_source(cfg, args)
    if cmd in ("purity", "mode"):  # "mode" kept as an alias
        return cmd_purity(cfg, args)
    if cmd == "filter":
        return cmd_filter(cfg, args)
    if cmd == "favorite":
        return cmd_favorite(cfg)
    if cmd == "ban":
        return cmd_ban(cfg)
    if cmd == "open":
        return cmd_open()
    if cmd == "interval":
        return cmd_interval(args)
    if cmd in ("pause", "resume"):
        return cmd_timer("stop" if cmd == "pause" else "start")
    if cmd == "download":
        return cmd_download(cfg, args)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
